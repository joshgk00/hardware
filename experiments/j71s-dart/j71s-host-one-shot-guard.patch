+/* The one-shot experiment requires controller-visible addresses to be physical. */
+static bool j71s_host_dma_identity(struct device *dev, void *cpu,
+                                   dma_addr_t dma, size_t size)
+{
+ struct sg_table sgt;
+ bool valid;
+ int ret;
+
+ if (!IS_ALIGNED(dma, SZ_4K) || size > DMA_BIT_MASK(36) ||
+     dma > DMA_BIT_MASK(36) - (size - 1))
+  return false;
+ ret = dma_get_sgtable_attrs(dev, &sgt, cpu, dma, size, DMA_ATTR_WRITE_COMBINE);
+ if (ret)
+  return false;
+ valid = sgt.nents == 1 && sgt.sgl->length >= size && sg_phys(sgt.sgl) == dma;
+ sg_free_table(&sgt);
+ return valid;
+}
