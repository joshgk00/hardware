+/* J71t-derived candidate; FIFO status and retirement semantics are unverified. */
+static int apple_h9p_j71s_invalidate(struct apple_h9p_pcie *pcie, unsigned int tag)
+{
+ struct apple_h9p_nvmmu *nvmmu = &pcie->nvmmu;
+ unsigned long flags;
+ u32 value;
+ int ret;
+
+ spin_lock_irqsave(&nvmmu->j71s_inv_lock, flags);
+ if (nvmmu->j71s_poisoned) {
+  ret = -EIO;
+  goto out;
+ }
+ ret = readl_poll_timeout_atomic(pcie->base_port[0] + 0x22c, value,
+                                value != U32_MAX && (value & BIT(0)), 1, 20000);
+ if (ret)
+  goto poison;
+ writel(tag, nvmmu->base + H9P_NVMMU_TCB_CTRL);
+ ret = readl_poll_timeout_atomic(pcie->base_port[0] + 0x22c, value,
+                                value != U32_MAX && (value & BIT(0)), 1, 20000);
+ if (ret)
+  goto poison;
+ goto out;
+poison:
+ nvmmu->j71s_poisoned = true;
+out:
+ spin_unlock_irqrestore(&nvmmu->j71s_inv_lock, flags);
+ return ret;
+}
